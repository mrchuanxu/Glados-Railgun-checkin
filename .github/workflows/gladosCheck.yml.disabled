name: auto check

on:
  workflow_dispatch:
  schedule:
    # UTC 04:07-07:52 = 北京时间 12:07-15:52，避开整点高负载
    - cron: '7,22,37,52 4-7 * * *'
    # 北京时间 16:00 的最后一次触发
    - cron: '0 8 * * *'

concurrency:
  group: glados-checkin
  cancel-in-progress: false

jobs:
  build:
    name: glados/railgun checkin
    runs-on: ubuntu-latest
      
    permissions:
      contents: read
      actions: write

    strategy:
      matrix:
        python-version: [3.13]

    # 这里加入全局环境变量，强制后续所有第三方 actions 兼容 Node.js 24 运行环境
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

    steps:
    - name: Checkout Code
      uses: actions/checkout@v6

    - name: Restore runtime state
      id: state-cache
      uses: actions/cache/restore@v4
      with:
        path: .state
        key: glados-state-${{ github.run_id }}-${{ github.run_attempt }}
        restore-keys: |
          glados-state-

    - name: Show schedule diagnostics
      env:
        TRIGGER_EVENT: ${{ github.event_name }}
        TRIGGER_SCHEDULE: ${{ github.event.schedule }}
        CACHE_MATCHED_KEY: ${{ steps.state-cache.outputs.cache-matched-key }}
      run: |
        echo "event_name: $TRIGGER_EVENT"
        if [ -n "$TRIGGER_SCHEDULE" ]; then
          echo "scheduled_cron: $TRIGGER_SCHEDULE"
        else
          echo "scheduled_cron: manual trigger"
        fi
        echo "runner_utc: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "runner_beijing: $(TZ=Asia/Shanghai date '+%Y-%m-%d %H:%M:%S %Z')"
        if [ -n "$CACHE_MATCHED_KEY" ]; then
          echo "state_cache: $CACHE_MATCHED_KEY"
        else
          echo "state_cache: no matching cache"
        fi

    - name: Check daily completion gate
      id: gate
      run: |
        mkdir -p .state
        python schedule_gate.py \
          --state-file ".state/checkin-state.json" \
          --github-output "$GITHUB_OUTPUT"

    - name: Set up Python ${{ matrix.python-version }}
      if: steps.gate.outputs.should_run == 'true'
      uses: actions/setup-python@v6
      with:
        python-version: ${{ matrix.python-version }}

    # 安装 python 库
    - name: Install dependencies
      if: steps.gate.outputs.should_run == 'true'
      run: |
        python -m pip install --upgrade pip
        pip install requests
        pip install pypushdeer

    # 执行 签到脚本
    - name: Running checkin
      if: steps.gate.outputs.should_run == 'true'
      run: |
        python checkin.py
      env:
        PUSHDEER_SENDKEY: ${{ secrets.PUSHDEER_SENDKEY }}
        GLADOS_COOKIES: ${{ secrets.GLADOS_COOKIES }}
        GLADOS_EXCHANGE_INTERVAL_DAYS: ${{ secrets.GLADOS_EXCHANGE_INTERVAL_DAYS }}
        GLADOS_VERBOSE: ${{ secrets.GLADOS_VERBOSE }}

    - name: Save runtime state
      if: ${{ always() && steps.gate.outputs.should_run == 'true' }}
      uses: actions/cache/save@v4
      with:
        path: .state
        key: glados-state-${{ github.run_id }}-${{ github.run_attempt }}

    - name: Keep alive
      if: steps.gate.outputs.should_run == 'true'
      uses: liskin/gh-workflow-keepalive@v1 
